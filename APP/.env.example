# Copy these into Vercel: Project Settings -> Environment Variables (then redeploy).
# Never commit real values. VITE_* variables are baked into the client at build time.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GEMINI_API_KEY=
VITE_GOOGLE_CLIENT_ID=
# Optional
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# Google OAuth
# Use the WEB application OAuth client ID here (ends with .apps.googleusercontent.com).
VITE_GOOGLE_CLIENT_ID=
