# Copy this file to .env (or .env.local) and fill in your own keys. Never commit .env.
#
# TWO INDEPENDENT GROQ KEY POOLS (see server-app.ts -> callAIWithFallback):
# a burst of traffic on one job can never exhaust the keys the other job
# needs, because each has its own dedicated pair of keys.
#
#   TONE POOL (assessment) - GROQ_API_KEY, GROQ_API_KEY_2
#     Used ONLY by /api/tone-analysis: the PRIMARY engine reading a check-in
#     answer's tone/emotion, run as the majority vote in the three-way
#     NeuroScope DistilBERT x RoBERTa x Groq ensemble (see
#     ensembleThreeWaySentiment() in src/utils/semanticEngine.ts). It always
#     classifies into - and stays bound by - the same taxonomy and safety
#     rules the two tuned transformers use (critical-band safety bypass,
#     sticky severity), so a majority vote never overrides a corroborated
#     transformer "severe" reading.
#     Fallback order: Groq (GROQ_API_KEY) -> Groq (GROQ_API_KEY_2) -> Gemini
#     (GEMINI_API_KEY). This route deliberately skips the local-Phi rung to
#     stay fast during a live assessment.
#
#   COMMUNICATION POOL (solution drafting) - GROQ_API_KEY_3, GROQ_API_KEY_4
#     Used by every other AI-backed route: /api/assess, /api/feeling-solution,
#     /api/reassess, /api/solution-followup, /api/dimension-insight,
#     /api/translate. Drafts the empathetic write-up once the assessment
#     above has already run - it no longer decides clinical framing.
#     Fallback order: Groq (GROQ_API_KEY_3) -> Groq (GROQ_API_KEY_4) ->
#     Gemini (GEMINI_API_KEY) -> local Phi-4-mini/Phi-3 (see below).
#
# None of the four Groq keys are individually required - every rung degrades
# gracefully to the next when a key is unset/rate-limited/erroring, and each
# pool works fine with only its first key set (the second is just extra
# headroom before falling to Gemini).

# --- Tone / assessment pool --------------------------------------------------
# Primary tone-pool key. Get a free key at https://console.groq.com/keys
GROQ_API_KEY="

# Secondary tone-pool key (a different Groq account/project works well) -
# used automatically once GROQ_API_KEY hits its rate limit or errors out.
GROQ_API_KEY_2=""

# --- Communication / solution-drafting pool ---------------------------------
# Primary communication-pool key. Use a THIRD Groq account/project's key here
# (not the same value as GROQ_API_KEY/GROQ_API_KEY_2 above) so this pool's
# rate limit is genuinely independent of the tone pool's.
GROQ_API_KEY_3=""

# Secondary communication-pool key - used automatically once GROQ_API_KEY_3
# hits its rate limit or errors out.
GROQ_API_KEY_4=""

# Optional: comma-separated Groq model IDs to try in order, for when Groq
# deprecates the current default(s) - check https://console.groq.com/docs/deprecations
# and paste the replacement model ID(s) here, no code changes/redeploy needed.
# Applies to every Groq call in both pools.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b

# Shared fallback for BOTH pools - only used once all keys in the relevant
# pool have failed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="

# --- Local last-resort fallback: Phi-4-mini (or Phi-3) on your own machine ----
# Only reached if BOTH communication-pool Groq keys AND Gemini all fail/are
# unset. Note: the /api/tone-analysis assessment route deliberately skips
# this rung (it stays on the fast cloud providers so a live assessment never
# waits on it) - LOCAL_LLM_* below is only used by the "communication" routes.
# Run Phi-4-mini (default) or Phi-3-mini locally with an OpenAI-compatible
# chat-completions endpoint, e.g.:
#   Ollama, Phi-4-mini: `ollama pull phi4-mini` -> serves at http://localhost:11434/v1/chat/completions
#   Ollama, Phi-3:      `ollama pull phi3`      -> same URL, set LOCAL_LLM_MODEL=phi3 below
#   LM Studio: load "phi-4-mini" or "phi-3-mini", start its local server (default http://localhost:1234/v1/chat/completions)
# Defaults below assume Ollama's default port/Phi-4-mini model name - set
# LOCAL_LLM_MODEL=phi3 to use Phi-3 instead, or override further if you use
# something else, or set LOCAL_LLM_ENABLED=false to turn this rung off entirely
# (e.g. on a server deployment with no local model to fall back to).
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=phi4-mini

# Google Sign-In (optional). Create an OAuth Client ID (type "Web application")
# at https://console.cloud.google.com/apis/credentials, then set it here.
VITE_GOOGLE_CLIENT_ID=""
